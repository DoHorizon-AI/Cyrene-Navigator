# ┌─────────────────────────────────────────────────────────────────────┐
# │ Container: Cyrene Navigator Cloud Executor Daemon                   │
# │ Role: Headless background Agent executor with Playwright & plugins  │
# │ 职责：Navigator 云端无头执行器容器，支持浏览器自动化与插件热更新       │
# └─────────────────────────────────────────────────────────────────────┘

FROM node:22-bookworm-slim AS base

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0 \
    NAVIGATOR_PLUGINS_DIR=/app/plugins \
    CYRENE_WORKSPACE_ID=cloud-workspace

# Install system utilities, python, and Playwright / Chromium headless dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@11.7.0

WORKDIR /app

# Copy repository sources
COPY package.json ./
COPY harness/ ./harness/
COPY scripts/ ./scripts/
COPY src/ ./src/

# Link and build harness adapters
RUN mkdir -p /app/plugins /app/workspace
RUN cd /app/harness && pnpm install --frozen-lockfile || true

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health || exit 1

ENTRYPOINT ["node", "scripts/serve-executor.mjs"]
CMD ["--port", "8080", "--host", "0.0.0.0", "--plugins-dir", "/app/plugins"]
