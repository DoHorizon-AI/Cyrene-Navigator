<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Retinting the platform, not replacing it / 给原生控件重着色，而不是替换它们。

        Every control this app uses from WinUI keeps its own template, states, animations,
        keyboard behaviour and accessibility tree. What changes is the palette those templates
        resolve against, done by overriding the theme *colour* resources they are built on.

        Two consequences worth stating:

        · Buttons, toggles, sliders and check boxes take Cyrene's ink as their accent rather than
          the user's system accent colour. That is intentional: the brand does not build identity
          out of large saturated fills, and the website's primary button is ink on paper.
        · Focus rings become orchid, matching the website's `:focus-visible` outline. It is the
          one place brand colour is allowed on a system control, because focus is the one system
          state that should feel like the product's own.

        Values here are duplicated from Design/Palette.cs. tools/xamlcheck.py verifies the two
        stay in agreement.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- =============================== Light (designed) =============================== -->
        <ResourceDictionary x:Key="Light">

            <!-- Text -->
            <Color x:Key="TextFillColorPrimary">#1B1E26</Color>
            <Color x:Key="TextFillColorSecondary">#52505B</Color>
            <Color x:Key="TextFillColorTertiary">#7C7A86</Color>
            <Color x:Key="TextFillColorDisabled">#A9A6B0</Color>
            <Color x:Key="TextOnAccentFillColorPrimary">#FBFAF8</Color>
            <Color x:Key="TextOnAccentFillColorSecondary">#E6E2DC</Color>
            <Color x:Key="TextOnAccentFillColorDisabled">#C9C5C0</Color>

            <!-- Accent: ink, matching the brand's solid button -->
            <Color x:Key="AccentFillColorDefault">#1B1E26</Color>
            <Color x:Key="AccentFillColorSecondary">#2C3039</Color>
            <Color x:Key="AccentFillColorTertiary">#3A3F4A</Color>
            <Color x:Key="AccentFillColorDisabled">#DDD8D2</Color>
            <Color x:Key="AccentTextFillColorPrimary">#8E4FA6</Color>
            <Color x:Key="AccentTextFillColorSecondary">#7B4290</Color>
            <Color x:Key="AccentTextFillColorTertiary">#8E4FA6</Color>
            <Color x:Key="AccentTextFillColorDisabled">#A9A6B0</Color>

            <!-- Control surfaces -->
            <Color x:Key="ControlFillColorDefault">#FBFAF8</Color>
            <Color x:Key="ControlFillColorSecondary">#F5F2EE</Color>
            <Color x:Key="ControlFillColorTertiary">#EFEBE6</Color>
            <Color x:Key="ControlFillColorDisabled">#F3F0EC</Color>
            <Color x:Key="ControlFillColorInputActive">#FFFFFF</Color>
            <Color x:Key="ControlStrokeColorDefault">#E9E5E1</Color>
            <Color x:Key="ControlStrokeColorSecondary">#DAD4CD</Color>
            <Color x:Key="ControlStrongStrokeColorDefault">#8A8792</Color>
            <Color x:Key="ControlStrongStrokeColorDisabled">#DAD4CD</Color>

            <!-- Hover and pressed washes: warm, and barely there -->
            <Color x:Key="SubtleFillColorSecondary">#F5F2EE</Color>
            <Color x:Key="SubtleFillColorTertiary">#EDE8E2</Color>

            <!-- Page and layer fills -->
            <Color x:Key="SolidBackgroundFillColorBase">#FBFAF8</Color>
            <Color x:Key="SolidBackgroundFillColorBaseAlt">#F3F0EC</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#F3F0EC</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#F5F2EE</Color>
            <Color x:Key="SolidBackgroundFillColorQuarternary">#FFFFFF</Color>
            <Color x:Key="LayerFillColorDefault">#FBFAF8</Color>
            <Color x:Key="LayerFillColorAlt">#FBFAF8</Color>
            <Color x:Key="CardBackgroundFillColorDefault">#FBFAF8</Color>
            <Color x:Key="CardBackgroundFillColorSecondary">#F5F2EE</Color>
            <Color x:Key="CardStrokeColorDefault">#E9E5E1</Color>
            <Color x:Key="DividerStrokeColorDefault">#E9E5E1</Color>

            <!-- Focus: the one system state allowed to be brand-coloured -->
            <Color x:Key="FocusStrokeColorOuter">#C77FD6</Color>
            <Color x:Key="FocusStrokeColorInner">#FBFAF8</Color>

            <!-- Status -->
            <Color x:Key="SystemFillColorSuccess">#2E7D5B</Color>
            <Color x:Key="SystemFillColorCaution">#A8712C</Color>
            <Color x:Key="SystemFillColorCritical">#C0514B</Color>
            <Color x:Key="SystemFillColorAttention">#8E4FA6</Color>
            <Color x:Key="SystemFillColorSuccessBackground">#E9F2ED</Color>
            <Color x:Key="SystemFillColorCautionBackground">#F7EFE3</Color>
            <Color x:Key="SystemFillColorCriticalBackground">#F8EAE9</Color>
            <Color x:Key="SystemFillColorAttentionBackground">#F3EAF6</Color>

            <!-- Flyouts and dialogs are paper, not acrylic: a transcript behind a menu should
                 not bleed through and make the menu hard to read. -->
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#FBFAF8" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FBFAF8" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FBFAF8" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#F3F0EC" />
        </ResourceDictionary>

        <!-- ============================ Default = dark (secondary) ======================== -->
        <ResourceDictionary x:Key="Default">

            <Color x:Key="TextFillColorPrimary">#F2F0EC</Color>
            <Color x:Key="TextFillColorSecondary">#B4B1BC</Color>
            <Color x:Key="TextFillColorTertiary">#8F8D9A</Color>
            <Color x:Key="TextFillColorDisabled">#5C5A66</Color>
            <Color x:Key="TextOnAccentFillColorPrimary">#15171E</Color>
            <Color x:Key="TextOnAccentFillColorSecondary">#2A2D37</Color>
            <Color x:Key="TextOnAccentFillColorDisabled">#4A4854</Color>

            <Color x:Key="AccentFillColorDefault">#F2F0EC</Color>
            <Color x:Key="AccentFillColorSecondary">#DCD9D4</Color>
            <Color x:Key="AccentFillColorTertiary">#C4C1BC</Color>
            <Color x:Key="AccentFillColorDisabled">#3A3E4A</Color>
            <Color x:Key="AccentTextFillColorPrimary">#D6A1E8</Color>
            <Color x:Key="AccentTextFillColorSecondary">#C78FDC</Color>
            <Color x:Key="AccentTextFillColorTertiary">#D6A1E8</Color>
            <Color x:Key="AccentTextFillColorDisabled">#5C5A66</Color>

            <Color x:Key="ControlFillColorDefault">#1D2029</Color>
            <Color x:Key="ControlFillColorSecondary">#232631</Color>
            <Color x:Key="ControlFillColorTertiary">#2A2D37</Color>
            <Color x:Key="ControlFillColorDisabled">#1D2029</Color>
            <Color x:Key="ControlFillColorInputActive">#15171E</Color>
            <Color x:Key="ControlStrokeColorDefault">#2A2D37</Color>
            <Color x:Key="ControlStrokeColorSecondary">#3A3E4A</Color>
            <Color x:Key="ControlStrongStrokeColorDefault">#8F8D9A</Color>
            <Color x:Key="ControlStrongStrokeColorDisabled">#3A3E4A</Color>

            <Color x:Key="SubtleFillColorSecondary">#232631</Color>
            <Color x:Key="SubtleFillColorTertiary">#2A2D37</Color>

            <Color x:Key="SolidBackgroundFillColorBase">#15171E</Color>
            <Color x:Key="SolidBackgroundFillColorBaseAlt">#1D2029</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#1D2029</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#232631</Color>
            <Color x:Key="SolidBackgroundFillColorQuarternary">#2A2D37</Color>
            <Color x:Key="LayerFillColorDefault">#1D2029</Color>
            <Color x:Key="LayerFillColorAlt">#232631</Color>
            <Color x:Key="CardBackgroundFillColorDefault">#1D2029</Color>
            <Color x:Key="CardBackgroundFillColorSecondary">#232631</Color>
            <Color x:Key="CardStrokeColorDefault">#2A2D37</Color>
            <Color x:Key="DividerStrokeColorDefault">#2A2D37</Color>

            <Color x:Key="FocusStrokeColorOuter">#C77FD6</Color>
            <Color x:Key="FocusStrokeColorInner">#15171E</Color>

            <Color x:Key="SystemFillColorSuccess">#6CC9A0</Color>
            <Color x:Key="SystemFillColorCaution">#D8A65B</Color>
            <Color x:Key="SystemFillColorCritical">#E37A74</Color>
            <Color x:Key="SystemFillColorAttention">#D6A1E8</Color>
            <Color x:Key="SystemFillColorSuccessBackground">#1B2B25</Color>
            <Color x:Key="SystemFillColorCautionBackground">#2B2419</Color>
            <Color x:Key="SystemFillColorCriticalBackground">#2B1D1D</Color>
            <Color x:Key="SystemFillColorAttentionBackground">#241E2B</Color>

            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#1D2029" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#1D2029" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#15171E" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#1D2029" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Theme-independent geometry and type. The brand uses a very tight radius set, so the
         platform's 4px control radius stays and only the overlay radius tightens to 6. -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

</ResourceDictionary>
