<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Cyrene.Navigator.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <!--
        The only XAML in the project. Everything else is composed in code so it can be
        type-checked; this file exists because WinUI requires an Application-derived class with a
        XAML resource root, and because retinting the platform's own controls is done by
        overriding theme resources, which is a declarative operation.

        全项目唯一的 XAML：加载 WinUI 默认资源，然后用 Overrides.xaml 给原生控件重着色。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Overrides.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
