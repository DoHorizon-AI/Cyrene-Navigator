{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cyrene.dev/navigator/product/v1/workspace-snapshot.schema.json",
  "title": "Navigator WorkspaceSnapshot v1",
  "type": "object",
  "required": ["workspaceId", "status", "views", "observedAt"],
  "properties": {
    "workspaceId": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]},
    "views": {
      "type": "array",
      "items": {"$ref": "#/$defs/productView"}
    },
    "observedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "productView": {
      "type": "object",
      "required": ["product", "sourceOperation", "observedAt", "status"],
      "properties": {
        "product": {"enum": ["CATALYST", "ECHO", "REACTOR", "EXCHANGE", "YIELD"]},
        "sourceOperation": {
          "type": "string",
          "description": "Fixed owner OpenAPI operation identifier for non-navigable provenance; not a resource reference.",
          "enum": ["workspaceListDatasets", "workspaceGetEvaluationSuite", "listWorkspaceGatewayRoutes", "workspaceListModelImports", "workspaceGetDraft"]
        },
        "observedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
        "resourceSummary": {
          "type": "object",
          "required": ["jsonSha256", "canonicalJsonBytes"],
          "properties": {
            "jsonSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "canonicalJsonBytes": {"type": "integer", "minimum": 2, "maximum": 4194304}
          },
          "additionalProperties": false,
          "description": "Non-navigable digest and size summary; the owner JSON body is not returned."
        },
        "problem": {"$ref": "#/$defs/observationProblem"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "AVAILABLE"}}},
          "then": {"required": ["resourceSummary"]}
        },
        {
          "if": {"properties": {"status": {"const": "UNAVAILABLE"}}},
          "then": {"required": ["problem"]}
        }
      ],
      "additionalProperties": false
    },
    "observationProblem": {
      "type": "object",
      "required": ["code", "detail", "retryable"],
      "properties": {
        "code": {"type": "string"},
        "detail": {"type": "string"},
        "retryable": {"type": "boolean"},
        "upstreamStatus": {"type": "integer", "minimum": 400, "maximum": 599}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
